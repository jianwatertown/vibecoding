  "dependencies": { "next": "16.4.0", "react": "19.3.0", "react-dom": "19.3.0", "qrcode": "1.5.4" },
  "devDependencies": { "typescript": "^5.9.3", "tsx": "^4.21.0", "@types/node": "^24", "@types/react": "^19", "@types/react-dom": "^19", "@types/qrcode": "^1.5.6" }
}
